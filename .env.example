# Example environment variables for AsthmaDaily RAG
# Copy to a real .env or export these variables in your shell before running webapp.py

# OpenAI API key (if you want abstractive LLM summaries)
OPENAI_API_KEY=

# Preferred OpenAI model (optional). Examples: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-3.5-turbo

# PDF generation: pdfkit requires wkhtmltopdf binary on your system.
# No env var required; install wkhtmltopdf and ensure it's on your PATH.

# Debug endpoint protection and feature flag
# Set to 'false' to disable the debug/sample endpoint
DEBUG_SAMPLE_ENABLED=true
# Optional admin token to protect debug endpoints. If set, pass ?admin=<token> when calling.
ADMIN_PASSWORD=

# Enable PDF attempts (pdfkit + wkhtmltopdf). Set false to never attempt PDF generation.
PDF_ENABLED=true
