{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grounded generation response",
  "type": "object",
  "required": ["recommendation", "evidence", "citations", "confidence"],
  "properties": {
    "recommendation": { "type": "string" },
    "evidence": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document": { "type": "string" },
          "section": { "type": "string" },
          "page": { "type": "integer" }
        }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "insufficient"] }
  }
}
